{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://safa.dev/contracts/source-preview-manifest-v1.schema.json",
  "title": "SAFA source preview manifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "runtime_version",
    "cli_schema",
    "platform",
    "architectures",
    "minimum_os_version",
    "minimum_xcode_version",
    "source",
    "installer"
  ],
  "properties": {
    "schema": {
      "const": "dev.safa.source-preview-manifest/v1"
    },
    "runtime_version": {
      "$ref": "#/$defs/semver"
    },
    "cli_schema": {
      "const": "dev.safa.cli/v2"
    },
    "platform": {
      "const": "macos"
    },
    "architectures": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "enum": ["arm64", "x86_64"]
      }
    },
    "minimum_os_version": {
      "$ref": "#/$defs/numericVersion"
    },
    "minimum_xcode_version": {
      "$ref": "#/$defs/numericVersion"
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "repository",
        "revision",
        "archive_url",
        "sha256",
        "archive_format",
        "root_directory"
      ],
      "properties": {
        "repository": {
          "const": "https://github.com/juju-w/safa-runtime"
        },
        "revision": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "archive_url": {
          "type": "string",
          "pattern": "^https://github\\.com/juju-w/safa-runtime/archive/[0-9a-f]{40}\\.tar\\.gz$"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "archive_format": {
          "const": "tar.gz"
        },
        "root_directory": {
          "type": "string",
          "pattern": "^safa-runtime-[0-9a-f]{40}$"
        }
      }
    },
    "installer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "signing_kind"],
      "properties": {
        "path": {
          "const": "Scripts/install-local-runtime.sh"
        },
        "signing_kind": {
          "const": "local-apple-development"
        }
      }
    }
  },
  "$defs": {
    "semver": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"
    },
    "numericVersion": {
      "type": "string",
      "pattern": "^[0-9]+(?:\\.[0-9]+){1,2}$"
    }
  }
}
